# 后端环境变量示例：复制成 .env 后按自己的情况改
# 注意：.env 里有数据库密码和 JWT 密钥，不要提交到公开仓库

# 数据库主机（本机就是 localhost）
DB_HOST=localhost
# 数据库名（本项目用 zp_database）
DB_NAME=zp_database
# 数据库账号
DB_USER=root
# 数据库密码
DB_PASSWORD=your_password
# JWT 签名密钥，生成一个足够长的随机串（例如 64 位十六进制）
JWT_SECRET=please_change_me_to_a_long_random_string
# 后端端口，前端 vite.config.js 里的 proxy 默认指向 3000
PORT=3000
