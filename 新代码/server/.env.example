# 后端环境变量示例：复制成 .env 后按自己的情况改
# 注意：.env 里有数据库密码和 JWT 密钥，不要提交到公开仓库

# 数据库主机（本机就是 localhost）
DB_HOST=localhost
# 数据库名（本项目用 zp_database）
DB_NAME=zp_database
# 数据库账号
DB_USER=root
# 数据库密码
DB_PASSWORD=your_password
# JWT 签名密钥，生成一个足够长的随机串（例如 64 位十六进制）
JWT_SECRET=please_change_me_to_a_long_random_string
# 后端端口，前端 vite.config.js 里的 proxy 默认指向 3000
PORT=3000

# 评论是否「先审后发」：
#   false / 不填 —— 发出来立刻可见（现在的默认）
#   true         —— 新评论进入 pending，公开列表只显示 approved，
#                   需要管理员在 /api/admin/comments 审核通过后才出现
# 审核接口已就绪，等管理页面做好后把这个开关打开即可
COMMENT_AUDIT=false

# ───────────── 找回密码用的邮件服务（不填则走开发模式）─────────────
# 不填时：验证码只打印在后端控制台，并通过接口的 devCode 返回，方便本地调试
# 填了之后：真的发邮件，接口不再返回 devCode
#
# QQ 邮箱：smtp.qq.com  465（SSL）  —— SMTP_PASS 填「授权码」，不是 QQ 密码
# 163 邮箱：smtp.163.com 465（SSL）  —— 同样用授权码
# Gmail：  smtp.gmail.com 465 / 587 —— 需要应用专用密码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=你的发件邮箱@qq.com
# SMTP_PASS=邮箱的SMTP授权码
# MAIL_FROM=普骑屋 <你的发件邮箱@qq.com>
